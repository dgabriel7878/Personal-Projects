# Copy this file to .env and fill in your Alpaca PAPER trading API keys.
# Get them from https://app.alpaca.markets/paper/dashboard/overview
# (sign up free, switch to "Paper Trading" in the left sidebar, then
# generate keys there -- NOT from the live-trading dashboard).
#
# .env is gitignored; never commit real keys.

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
